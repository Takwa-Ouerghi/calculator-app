pipeline{
    agent any
    parameters {
        choice (
            name: 'ENVIRONMENT',
            choices: ['staging', 'production'],
            description: 'where to deploy'
        )
    }
    stages{
        stage('checkout'){
            steps{
                checkout scm
            }
        }
        stage('show Files'){
            steps{
                bat 'dir'
            }
        }
        stage('Test'){
            steps{
                bat 'python -m unittest test_calculator.py'
            }
        }
        stage('Deploy'){
            steps{
                bat 'xcopy /Y calculator.py dist\\'
            }
        }
    }
}